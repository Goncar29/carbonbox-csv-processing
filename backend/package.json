{
  "name": "carbonbox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Async CSV document processing API and worker",
  "prisma": {
    "schema": "src/document-processing/infrastructure/persistence/models/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=.env src/main/index.ts",
    "start": "node dist/main/index.js",
    "worker": "tsx --env-file=.env src/workers/index.ts",
    "start:worker": "node dist/workers/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@prisma/client": "6.19.3",
    "awilix": "13.0.5",
    "convict": "6.2.5",
    "csv-parse": "7.0.3",
    "fastify": "5.12.5",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/convict": "6.1.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
